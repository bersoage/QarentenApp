<?xml version="1.0" encoding="utf-8"?>
<!-- Backup automático de Android: guarda la configuración (grupos, ajustes) en la cuenta de Google
     y la devuelve sola al reinstalar la app. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="config.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="config.json" />
    </device-transfer>
</data-extraction-rules>
